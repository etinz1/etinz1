# Copy this file to .env and fill in your keys. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Only needed if your key starts with sk-ant-usr- (not tied to a workspace).
# Find the ID in the Claude Console under Settings -> Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# Optional: override the default "Adam" voice
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
